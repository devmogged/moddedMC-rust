index 000000000..6a0f6f830
--- /dev/null
+++ b/crates/pumpkin-data/src/modded.rs
@@ -0,0 +1,329 @@
+//! Blocks added by mods at startup, numbered after vanilla's.
+//!
+//! [`install`] runs once, before any world loads. Modded states then behave like vanilla ones:
+//! `BlockState::from_id`, `Block::from_state_id` and `Block::from_name` find them, and their
+//! physics (shape, hardness, light) are copied from the vanilla state each one looks like on a
+//! stock client ([`BlockDef::appearance`]). Clients get [`BlockStateId::to_client`].
+//!
+//! Runtime ids change between runs, so files never store them. Name-based formats (Anvil) save
+//! names; id-based formats (`.pump`) save [`to_saved`] ids: an index into an append-only list of
+//! state names that the caller keeps on disk and hands to [`install`].
+
+use std::{collections::HashMap, sync::OnceLock};
+
+use crate::{Block, BlockId, BlockState, BlockStateId};
+
+/// One modded block, as a mod defines it.
+pub struct BlockDef {
+    /// `namespace:path`, not `minecraft`.
+    pub name: String,
+    /// (name, values). States are every combination, the last property changing fastest;
+    /// the first state is the default.
+    pub properties: Vec<(String, Vec<String>)>,
+    /// The vanilla state a stock client sees, one per state, in state order.
+    pub appearance: Vec<BlockStateId>,
+}
+
+struct Modded {
+    blocks: Vec<&'static Block>,
+    /// Indexed by `id - BlockStateId::STATE_COUNT`.
+    states: Vec<(BlockId, BlockStateId)>,
+    properties: Vec<&'static [(String, Vec<String>)]>,
+    by_name: HashMap<&'static str, BlockId>,
+    /// Saved id offset (from `STATE_COUNT`) of each modded state, by runtime offset.
+    to_saved: Vec<u16>,
+    /// Runtime state of each saved id offset; air for states no block has any more.
+    from_saved: Vec<BlockStateId>,
+}
+
+static MODDED: OnceLock<Modded> = OnceLock::new();
+
+/// Installs the modded blocks. Call once, before any world loads.
+///
+/// `saved` is the list of state names behind saved ids, as last returned (empty the first time).
+/// Returns it with this run's new states appended; store it before any world loads.
+pub fn install(defs: Vec<BlockDef>, mut saved: Vec<String>) -> Result<Vec<String>, String> {
+    let mut modded = Modded {
+        blocks: Vec::new(),
+        states: Vec::new(),
+        properties: Vec::new(),
+        by_name: HashMap::new(),
+        to_saved: Vec::new(),
+        from_saved: Vec::new(),
+    };
+    let mut names: HashMap<String, BlockStateId> = HashMap::new();
+    for def in defs {
+        let count: usize = def.properties.iter().map(|(_, v)| v.len()).product();
+        if count == 0 || def.appearance.len() != count {
+            return Err(format!("{}: {count} states but {} appearances", def.name, def.appearance.len()));
+        }
+        if def.appearance.iter().any(|a| a.0 >= BlockStateId::STATE_COUNT) {
+            return Err(format!("{}: appearances must be vanilla states", def.name));
+        }
+        let first = usize::from(BlockStateId::STATE_COUNT) + modded.states.len();
+        let block_raw = usize::from(BlockId::BLOCK_COUNT) + modded.blocks.len();
+        let (Ok(_), Ok(block_raw)) = (u16::try_from(first + count - 1), u16::try_from(block_raw)) else {
+            return Err("too many modded block states".into());
+        };
+        let block_id = BlockId(block_raw);
+        let states: &'static [BlockState] = def
+            .appearance
+            .iter()
+            .enumerate()
+            .map(|(i, &look)| {
+                let v = BlockState::from_id(look);
+                BlockState {
+                    id: BlockStateId((first + i) as u16),
+                    state_flags: v.state_flags,
+                    side_flags: v.side_flags,
+                    instrument: v.instrument,
+                    luminance: v.luminance,
+                    piston_behavior: v.piston_behavior.clone(),
+                    hardness: v.hardness,
+                    collision_shapes: v.collision_shapes,
+                    outline_shapes: v.outline_shapes,
+                    opacity: v.opacity,
+                    sound_type: v.sound_type,
+                    // The mod owns its data; no vanilla block entity behind it.
+                    block_entity_type: u16::MAX,
+                }
+            })
+            .collect::<Vec<_>>()
+            .leak();
+        let name: &'static str = def.name.leak();
+        if modded.by_name.insert(name, block_id).is_some() || Block::from_name(name).is_some() {
+            return Err(format!("{name} is defined twice"));
+        }
+        let look = Block::from_state_id(def.appearance[0]);
+        let block: &'static Block = Box::leak(Box::new(Block {
+            id: block_id,
+            name,
+            default_state: &states[0],
+            states,
+            // Drops and fuel are the mod's business.
+            flammable: None,
+            experience: None,
+            loot_table: None,
+            ..look.clone()
+        }));
+        for state in states {
+            let index = usize::from(state.id.0) - first;
+            names.insert(full_name(name, &state_props(&def.properties, index)), state.id);
+        }
+        modded.blocks.push(block);
+        modded.properties.push(def.properties.leak());
+        modded.states.extend(def.appearance.iter().map(|&a| (block_id, a)));
+    }
+    let known: HashMap<&str, usize> = saved.iter().enumerate().map(|(i, n)| (n.as_str(), i)).collect();
+    let mut new: Vec<(String, BlockStateId)> = names
+        .iter()
+        .filter(|(n, _)| !known.contains_key(n.as_str()))
+        .map(|(n, &id)| (n.clone(), id))
+        .collect();
+    new.sort_by_key(|(_, id)| *id);
+    saved.extend(new.into_iter().map(|(n, _)| n));
+    if usize::from(BlockStateId::STATE_COUNT) + saved.len() > usize::from(u16::MAX) {
+        return Err("too many saved modded block states".into());
+    }
+    modded.to_saved = vec![0; modded.states.len()];
+    modded.from_saved = saved
+        .iter()
+        .enumerate()
+        .map(|(i, n)| {
+            let id = names.get(n).copied().unwrap_or(BlockStateId::AIR);
+            if is_modded(id) {
+                modded.to_saved[usize::from(id.0 - BlockStateId::STATE_COUNT)] = i as u16;
+            }
+            id
+        })
+        .collect();
+    MODDED.set(modded).map_err(|_| "modded blocks are already installed")?;
+    Ok(saved)
+}
+
+/// The (property, value) pairs of state `index` of a block with these properties.
+fn state_props(props: &[(String, Vec<String>)], mut index: usize) -> Vec<(&str, &str)> {
+    let mut out = vec![("", ""); props.len()];
+    for (slot, (key, values)) in out.iter_mut().zip(props).rev() {
+        *slot = (key.as_str(), values[index % values.len()].as_str());
+        index /= values.len();
+    }
+    out
+}
+
+fn full_name(name: &str, props: &[(&str, &str)]) -> String {
+    if props.is_empty() {
+        return name.to_owned();
+    }
+    let props: Vec<String> = props.iter().map(|(k, v)| format!("{k}={v}")).collect();
+    format!("{name}[{}]", props.join(","))
+}
+
+/// `shaft:shaft[axis=x]` for a modded state; `None` for vanilla ones.
+#[must_use]
+pub fn state_name(id: BlockStateId) -> Option<String> {
+    Some(full_name(Block::from_state_id(id).name, &properties(id)?))
+}
+
+/// The id an id-based file format stores for `id`.
+#[must_use]
+pub fn to_saved(id: BlockStateId) -> u16 {
+    match get() {
+        Some(m) if is_modded(id) => m
+            .to_saved
+            .get(usize::from(id.0 - BlockStateId::STATE_COUNT))
+            .map_or(BlockStateId::AIR.0, |s| BlockStateId::STATE_COUNT + s),
+        _ => id.0,
+    }
+}
+
+/// The state behind a stored id; air if nothing has it any more.
+#[must_use]
+pub fn from_saved(raw: u16) -> BlockStateId {
+    match raw.checked_sub(BlockStateId::STATE_COUNT) {
+        None => BlockStateId(raw),
+        Some(i) => get()
+            .and_then(|m| m.from_saved.get(usize::from(i)).copied())
+            .unwrap_or(BlockStateId::AIR),
+    }
+}
+
+fn get() -> Option<&'static Modded> {
+    MODDED.get()
+}
+
+fn entry(id: BlockStateId) -> Option<&'static (BlockId, BlockStateId)> {
+    get()?.states.get(usize::from(id.0.checked_sub(BlockStateId::STATE_COUNT)?))
+}
+
+/// Every modded state id; vanilla states are below `BlockStateId::STATE_COUNT`.
+#[must_use]
+pub fn state_count() -> usize {
+    get().map_or(0, |m| m.states.len())
+}
+
+/// A raw id from outside (a mod, a file) as a state id, if vanilla or installed.
+#[must_use]
+pub fn state_id(raw: u16) -> Option<BlockStateId> {
+    (usize::from(raw) < usize::from(BlockStateId::STATE_COUNT) + state_count())
+        .then_some(BlockStateId(raw))
+}
+
+#[must_use]
+pub const fn is_modded(id: BlockStateId) -> bool {
+    id.0 >= BlockStateId::STATE_COUNT
+}
+
+pub(crate) fn state(id: BlockStateId) -> &'static BlockState {
+    match entry(id) {
+        Some((block, _)) => {
+            let block = self::block(*block);
+            &block.states[usize::from(id.0 - block.states[0].id.0)]
+        }
+        None => BlockState::from_id(BlockStateId::AIR),
+    }
+}
+
+pub(crate) fn block_of(id: BlockStateId) -> BlockId {
+    entry(id).map_or(BlockId::AIR, |(block, _)| *block)
+}
+
+pub(crate) fn block(id: BlockId) -> &'static Block {
+    get()
+        .and_then(|m| m.blocks.get(usize::from(id.0.checked_sub(BlockId::BLOCK_COUNT)?)))
+        .copied()
+        .unwrap_or(&Block::AIR)
+}
+
+pub(crate) fn by_name(name: &str) -> Option<&'static Block> {
+    get()?.by_name.get(name).map(|&id| block(id))
+}
+
+/// [`BlockStateId::to_client`] for a raw id from a packet.
+#[must_use]
+pub fn client_raw(raw: i32) -> i32 {
+    u16::try_from(raw)
+        .ok()
+        .filter(|&r| r >= BlockStateId::STATE_COUNT)
+        .map_or(raw, |r| i32::from(appearance(BlockStateId(r)).0))
+}
+
+/// The vanilla state a stock client is shown for `id`.
+#[must_use]
+pub fn appearance(id: BlockStateId) -> BlockStateId {
+    entry(id).map_or(BlockStateId::AIR, |(_, look)| *look)
+}
+
+fn block_properties(block: &Block) -> Option<&'static [(String, Vec<String>)]> {
+    get()?.properties.get(usize::from(block.id.0.checked_sub(BlockId::BLOCK_COUNT)?)).copied()
+}
+
+/// (property, value) pairs of a modded state; `None` for vanilla states.
+#[must_use]
+pub fn properties(id: BlockStateId) -> Option<Vec<(&'static str, &'static str)>> {
+    let block = Block::from_state_id(id);
+    let props = block_properties(block)?;
+    Some(state_props(props, usize::from(id.0 - block.states[0].id.0)))
+}
+
+/// The state of modded `block` with these properties; missing ones keep the default.
+/// `None` for vanilla blocks, unknown properties or values.
+#[must_use]
+pub fn state_with<'a>(
+    block: &Block,
+    given: impl IntoIterator<Item = (&'a str, &'a str)>,
+) -> Option<BlockStateId> {
+    let props = block_properties(block)?;
+    let mut chosen = vec![0; props.len()];
+    for (key, value) in given {
+        let i = props.iter().position(|(k, _)| k == key)?;
+        chosen[i] = props[i].1.iter().position(|v| v == value)?;
+    }
+    let index = props
+        .iter()
+        .zip(chosen)
+        .fold(0, |acc, ((_, values), v)| acc * values.len() + v);
+    Some(BlockStateId(block.states[0].id.0 + index as u16))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn modded_states_round_trip() {
+        let look = |n: &str| Block::from_name(n).unwrap().default_state.id;
+        let saved = vec!["demo:gone".to_owned(), "demo:shaft[axis=y,powered=false]".to_owned()];
+        let saved = install(vec![BlockDef {
+            name: "demo:shaft".into(),
+            properties: vec![
+                ("axis".into(), vec!["x".into(), "y".into(), "z".into()]),
+                ("powered".into(), vec!["false".into(), "true".into()]),
+            ],
+            appearance: vec![look("stone"), look("dirt"), look("stone"), look("dirt"), look("stone"), look("glass")],
+        }], saved)
+        .unwrap();
+        // Known names keep their saved ids; new states are appended; gone ones read as air.
+        assert_eq!(saved.len(), 7);
+        assert_eq!(saved[2], "demo:shaft[axis=x,powered=false]");
+        let y = state_with(Block::from_name("demo:shaft").unwrap(), [("axis", "y")]).unwrap();
+        assert_eq!(to_saved(y), BlockStateId::STATE_COUNT + 1);
+        assert_eq!(from_saved(BlockStateId::STATE_COUNT + 1), y);
+        assert_eq!(from_saved(BlockStateId::STATE_COUNT), BlockStateId::AIR);
+        assert_eq!(from_saved(5), BlockStateId(5));
+        assert_eq!(state_name(y).as_deref(), Some("demo:shaft[axis=y,powered=false]"));
+        let block = Block::from_name("demo:shaft").unwrap();
+        assert_eq!(block.states.len(), 6);
+        let s = state_with(block, [("axis", "z"), ("powered", "true")]).unwrap();
+        assert!(is_modded(s));
+        assert_eq!(s.as_u16(), BlockStateId::STATE_COUNT + 5);
+        assert_eq!(Block::from_state_id(s).name, "demo:shaft");
+        assert_eq!(BlockState::from_id(s).id, s);
+        assert_eq!(properties(s).unwrap(), [("axis", "z"), ("powered", "true")]);
+        assert_eq!(s.to_client(), look("glass"));
+        assert_eq!(look("dirt").to_client(), look("dirt"));
+        assert_eq!(block.default_state.id.as_u16(), BlockStateId::STATE_COUNT);
+        assert!(state_with(block, [("axis", "w")]).is_none());
+        assert!(install(Vec::new(), Vec::new()).is_err());
+    }
+}
diff --git a/crates/pumpkin-data/src/modded_biome.rs b/crates/pumpkin-data/src/modded_biome.rs
new file mode 100644
index 000000000..ba0682f5e
--- /dev/null
+++ b/crates/pumpkin-data/src/modded_biome.rs
@@ -0,0 +1,85 @@
+//! Biomes mods add (moddedmc). They are installed once, before any world loads, with ids after
+//! vanilla's in a fixed order the host keeps, so ids saved in chunks stay valid. Server-side a
+//! modded biome behaves like its vanilla look-alike (spawns, weather); clients get its own
+//! definition through the registry sync, where custom biomes come after vanilla's sorted by name,
+//! so network ids are mapped when chunks are sent.
+
+use std::sync::OnceLock;
+
+use crate::biome::Biome;
+
+/// The client reads directly-encoded biomes with 7 bits: at most 128 biomes in all.
+pub const MAX_TOTAL: usize = 128;
+
+static MODDED: OnceLock<Vec<&'static Biome>> = OnceLock::new();
+static NETWORK: OnceLock<Vec<u8>> = OnceLock::new();
+
+/// Installs `(name, look-alike)` pairs in order; ids follow vanilla's. Once only.
+pub fn install(defs: &[(String, &'static Biome)]) -> Result<(), String> {
+    if Biome::ALL.len() + defs.len() > MAX_TOTAL {
+        return Err(format!(
+            "{} modded biomes: at most {} fit",
+            defs.len(),
+            MAX_TOTAL - Biome::ALL.len()
+        ));
+    }
+    let mut biomes = Vec::with_capacity(defs.len());
+    for (i, (name, look)) in defs.iter().enumerate() {
+        // SAFETY: a `Biome` holds only `'static` borrows and plain data and has no `Drop`, so a
+        // bitwise copy of a static one shares nothing that could be freed or mutated.
+        let mut biome: Biome = unsafe { std::ptr::read(*look) };
+        biome.id = u8::try_from(Biome::ALL.len() + i).map_err(|e| e.to_string())?;
+        biome.registry_id = Box::leak(name.clone().into_boxed_str());
+        biomes.push(&*Box::leak(Box::new(biome)));
+    }
+    MODDED
+        .set(biomes)
+        .map_err(|_| "modded biomes are already installed".to_owned())
+}
+
+#[must_use]
+pub fn by_id(id: u8) -> Option<&'static Biome> {
+    MODDED.get()?.get(usize::from(id).checked_sub(Biome::ALL.len())?).copied()
+}
+
+#[must_use]
+pub fn by_name(name: &str) -> Option<&'static Biome> {
+    MODDED.get()?.iter().copied().find(|b| b.registry_id == name)
+}
+
+/// Sets each modded biome's network id (its index in the synced biome registry). Once only.
+pub fn set_network(ids: Vec<u8>) {
+    let _ = NETWORK.set(ids);
+}
+
+/// The id a client knows this biome by.
+#[must_use]
+pub fn to_client(id: u8) -> u8 {
+    usize::from(id)
+        .checked_sub(Biome::ALL.len())
+        .and_then(|i| NETWORK.get()?.get(i).copied())
+        .unwrap_or(id)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn install_and_look_up() {
+        let defs = vec![("demo:glacier".to_owned(), &Biome::SNOWY_PLAINS)];
+        assert!(install(&defs).is_ok());
+        let first = u8::try_from(Biome::ALL.len()).unwrap_or(u8::MAX);
+        let biome = by_id(first).map(|b| (b.id, b.registry_id, b.be_network_id));
+        assert_eq!(
+            biome,
+            Some((first, "demo:glacier", Biome::SNOWY_PLAINS.be_network_id))
+        );
+        assert_eq!(by_name("demo:glacier").map(|b| b.id), Some(first));
+        assert_eq!(to_client(first), first);
+        set_network(vec![first + 1]);
+        assert_eq!(to_client(first), first + 1);
+        assert_eq!(to_client(3), 3);
+        assert!(by_id(first + 1).is_none());
+    }
+}
