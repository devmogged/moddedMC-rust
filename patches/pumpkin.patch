index 000000000..222c9f141
--- /dev/null
+++ b/crates/pumpkin-wasm-host-common/src/extension.rs
@@ -0,0 +1,38 @@
+//! moddedMC-rust: lets a host crate add WIT interfaces next to the v0.1 plugin API
+//! and find a plugin's extra exports, without the wasm host depending on that crate.
+
+use std::{
+    any::Any,
+    sync::{Arc, OnceLock},
+};
+
+use wasmtime::{
+    Store,
+    component::{Instance, Linker},
+};
+
+use crate::{plugin::WasmPlugin, state::PluginHostState};
+
+pub type ExtensionData = Arc<dyn Any + Send + Sync>;
+
+pub struct HostExtension {
+    /// Adds the extension's imports to the v0.1 linker.
+    pub add_to_linker: fn(&mut Linker<PluginHostState>) -> wasmtime::Result<()>,
+    /// Looks up the extension's exports right after instantiation.
+    /// `None` means the plugin does not use the extension.
+    pub on_instantiate: fn(&Instance, &mut Store<PluginHostState>) -> Option<ExtensionData>,
+    /// Called once the plugin's store is running, with what `on_instantiate` returned.
+    pub on_plugin_ready: fn(&Arc<WasmPlugin>, ExtensionData),
+}
+
+static HOST_EXTENSION: OnceLock<HostExtension> = OnceLock::new();
+
+/// Installs the extension. Must run before the plugin runtime is created; later calls are ignored.
+pub fn install(extension: HostExtension) {
+    let _ = HOST_EXTENSION.set(extension);
+}
+
+#[must_use]
+pub fn get() -> Option<&'static HostExtension> {
+    HOST_EXTENSION.get()
+}
