{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "moddedMC",
  "version": "0.1.0",
  "identifier": "gg.devmogged.moddedmc",
  "build": {
    "beforeDevCommand": "npm run companion && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run companion && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "moddedMC",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520,
        "backgroundColor": "#000000",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../../companion/build/libs/moddedmc-companion-0.1.0.jar": "moddedmc-companion.jar"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
