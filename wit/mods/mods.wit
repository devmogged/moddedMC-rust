/// Content API for moddedMC-rust mods. A content mod is an ordinary Pumpkin
/// `pumpkin:plugin` component that also imports `registry` and exports `content`.
package moddedmc:mods@0.1.0;

interface types {
    /// A block entity type. Its state is opaque bytes owned by the mod; the host
    /// persists them with the block and hands them back on every call.
    record block-entity-def {
        /// Namespaced id, e.g. `demo:counter`.
        id: string,
        /// Bumped by the mod when its state layout changes; saved next to the state.
        state-version: u32,
        initial-state: list<u8>,
        /// `some(n)`: loaded instances tick every `n` ticks (n > 0). `none`: event-driven only.
        tick-interval: option<u32>,
    }

    record block-def {
        /// Namespaced id, e.g. `demo:counter`.
        id: string,
        display-name: string,
        /// Vanilla block the client sees. Must be a block with a block entity
        /// (`minecraft:barrel`, `minecraft:dropper` or `minecraft:dispenser` in 0.1).
        stand-in: string,
        /// Id of a block entity type registered by this mod.
        block-entity: option<string>,
    }

    enum registration-error {
        invalid-definition,
        duplicate-id,
        unknown-entity-type,
        unsupported-stand-in,
        /// Registration is only open during `content.register`.
        registry-frozen,
    }

    record block-pos {
        x: s32,
        y: s32,
        z: s32,
    }

    record tick-input {
        /// Valid only within this batch.
        token: u32,
        /// Index returned by `registry.add-block-entity`.
        entity-type: u32,
        pos: block-pos,
        state: list<u8>,
    }

    record tick-update {
        token: u32,
        state: list<u8>,
    }

    record use-input {
        entity-type: u32,
        pos: block-pos,
        state: list<u8>,
        player-name: string,
        dimension: string,
    }

    /// One of this mod's blocks was placed (by a player, or by the console when `player-name` is none).
    record place-input {
        entity-type: u32,
        pos: block-pos,
        dimension: string,
        /// The entity type's initial state.
        state: list<u8>,
        player-name: option<string>,
    }

    /// One of this mod's blocks is about to be removed. Its state is final.
    record break-input {
        entity-type: u32,
        pos: block-pos,
        dimension: string,
        state: list<u8>,
        player-name: option<string>,
    }

    record use-result {
        /// New state, or `none` to keep it.
        state: option<list<u8>>,
        /// Shown to the player in the action bar.
        message: option<string>,
    }
}

interface registry {
    use types.{block-def, block-entity-def, registration-error};

    add-block-entity: func(def: block-entity-def) -> result<u32, registration-error>;
    add-block: func(def: block-def) -> result<_, registration-error>;
}

interface content {
    use types.{
        registration-error, tick-input, tick-update, use-input, use-result, place-input, break-input,
    };

    /// Called once by the host before the mod's blocks become active.
    register: func() -> result<_, registration-error>;

    /// A batch of due block entities from one dimension. Return only changed states.
    tick-block-entities: func(tick: u64, dimension: string, entries: list<tick-input>) -> list<tick-update>;

    /// A player right-clicked one of this mod's blocks.
    use-block: func(input: use-input) -> use-result;

    /// One of this mod's blocks was placed. Return a replacement for the initial state, or none.
    place-block: func(input: place-input) -> option<list<u8>>;

    /// One of this mod's blocks is being broken.
    break-block: func(input: break-input);
}

world content-mod {
    import registry;
    export content;
}
